rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Anything under /media/ or /downloads/ is publicly readable (used on the live site),
    // but only the signed-in admin can upload or delete.
    match /media/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /downloads/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
